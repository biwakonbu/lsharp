{
  "extraKnownMarketplaces": {
    "lsharp-local": {
      "source": {
        "source": "directory",
        "path": ".claude/plugins/todo-manager"
      }
    }
  },
  "enabledPlugins": {
    "todo-manager@lsharp-local": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/tdd-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/test-result-tracker.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
