/// L# WasmGC output bridge
///
/// WasmGC の packed byte array を Component Model の canonical ABI へ渡すための
/// 最小 output interface。実装時には core module 内で array→linear-memory の copy を
/// 行い、host は一回の呼び出しで bytes 全量を消費する。

package lsharp:wasmgc-output@0.1.0;

interface stdout {
  /// opaque bytes。呼び出し中だけ有効で、host 側の所有権を持たない。
  write: func(bytes: list<u8>);
}

world wasmgc-output {
  import stdout;
  export main: func() -> s64;
}

world wasmgc-cli {
  import stdout;
  import wasi:cli/exit@0.2.3;
  export wasi:cli/run@0.2.3;
}

/// Filesystem-enabled CLI world used to validate explicit preopen/rights wiring.
world wasmgc-cli-fs {
  import stdout;
  import wasi:cli/exit@0.2.3;
  import wasi:filesystem/preopens@0.2.3;
  import wasi:filesystem/types@0.2.3;
  export wasi:cli/run@0.2.3;
}

/// Filesystem-enabled CLI world with explicit stream resource operations.
world wasmgc-cli-fs-streams {
  import stdout;
  import wasi:cli/exit@0.2.3;
  import wasi:filesystem/preopens@0.2.3;
  import wasi:filesystem/types@0.2.3;
  import wasi:io/streams@0.2.3;
  export wasi:cli/run@0.2.3;
}
