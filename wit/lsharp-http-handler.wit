/// L# HTTP Handler Component World
///
/// wasi:http/incoming-handler を実装する guest component 定義。
/// L# プログラムが (defn handle [request] response) で HTTP handler を記述し、
/// サーバーレス / エッジ環境で実行可能にする。

package lsharp:http-handler@0.1.0;

world lsharp-http-handler {
  // --- HTTP ---
  // incoming-handler: リクエスト受信 + レスポンス返却
  import wasi:http/types@0.2.0;
  export wasi:http/incoming-handler@0.2.0;

  // --- I/O ---
  // リクエスト/レスポンスボディのストリーム操作
  import wasi:io/streams@0.2.0;
  import wasi:io/poll@0.2.0;

  // --- Outgoing requests (optional) ---
  // handler 内から外部 API を呼ぶ場合
  import wasi:http/outgoing-handler@0.2.0;

  // --- Utility ---
  import wasi:clocks/wall-clock@0.2.0;
  import wasi:random/random@0.2.0;

  // --- Logging ---
  import wasi:cli/stderr@0.2.0;
}
