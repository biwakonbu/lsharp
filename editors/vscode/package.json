{
  "name": "lsharp-vscode",
  "displayName": "L# Language Support",
  "description": "L# (lsharp) language support for Visual Studio Code - S-expression syntax with Hindley-Milner type inference",
  "version": "0.1.0",
  "publisher": "lsharp",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:lsharp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lsharp",
        "aliases": ["L#", "lsharp"],
        "extensions": [".ls"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lsharp",
        "scopeName": "source.lsharp",
        "path": "./syntaxes/lsharp.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "L#",
      "properties": {
        "lsharp.lspPath": {
          "type": "string",
          "default": "",
          "description": "lsharp バイナリのパス (空の場合は PATH から検索)"
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "package": "npm run compile && vsce package --no-dependencies",
    "install-ext": "npm run package && code --install-extension lsharp-vscode-0.1.0.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.82.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
