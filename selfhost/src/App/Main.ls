(defn make-src-decl-pair [src decls] (vector-push (vector-push (vector-new 2) src) decls))
(defn text-hash [text] (name-hash text 0 (string-length text)))
(defn text-eq [left right] (if (= (string-length left) (string-length right)) (= (text-hash left) (text-hash right)) false))
(defn path-char [path idx] (string-char-at path idx))
(defn is-path-sep [path idx] (let [ch (path-char path idx)] (if (= ch 47) true (if (= ch 92) true false))))
(defn find-last-path-sep [path idx len last] (if (>= idx len) last (find-last-path-sep path (+ idx 1) len (if (is-path-sep path idx) idx last))))
(defn path-parent [path] (let [len (string-length path) last (find-last-path-sep path 0 len -1)] (if (< last 0) "" (if (= last 0) "/" (substring path 0 last)))))
(defn path-basename [path] (let [len (string-length path) last (find-last-path-sep path 0 len -1)] (if (< last 0) path (substring path (+ last 1) len))))
(defn path-join [base child] (if (= (string-length base) 0) child (let [len (string-length base)] (if (is-path-sep base (- len 1)) (string-concat base child) (string-concat (string-concat base "/") child)))))
(defn find-src-ancestor [dir] (if (= (string-length dir) 0) "" (if (text-eq (path-basename dir) "src") dir (let [parent (path-parent dir)] (if (text-eq parent dir) "" (find-src-ancestor parent))))))
(defn find-manifest-root [dir] (if (= (string-length dir) 0) "" (if (file-exists? (path-join dir "lsharp.toml")) dir (let [parent (path-parent dir)] (if (text-eq parent dir) "" (find-manifest-root parent))))))
(defn resolve-source-root [entry-path] (let [entry-dir (path-parent entry-path) manifest-root (find-manifest-root entry-dir) src-root (find-src-ancestor entry-dir)] (if (> (string-length manifest-root) 0) (path-join manifest-root "src") (if (> (string-length src-root) 0) src-root entry-dir))))
(defn resolve-package-root [entry-path] (let [entry-dir (path-parent entry-path) manifest-root (find-manifest-root entry-dir) src-root (find-src-ancestor entry-dir)] (if (> (string-length manifest-root) 0) manifest-root (if (> (string-length src-root) 0) (path-parent src-root) entry-dir))))
(defn module-name-to-relative-loop [name idx len out] (if (>= idx len) (string-concat out ".ls") (let [piece (if (= (path-char name idx) 46) "/" (substring name idx (+ idx 1)))] (module-name-to-relative-loop name (+ idx 1) len (string-concat out piece)))))
(defn module-name-to-relative [name] (module-name-to-relative-loop name 0 (string-length name) ""))
(defn module-name-to-index-relative-loop [name idx len out] (if (>= idx len) (string-concat out ".path") (let [piece (if (= (path-char name idx) 46) "/" (substring name idx (+ idx 1)))] (module-name-to-index-relative-loop name (+ idx 1) len (string-concat out piece)))))
(defn module-name-to-index-relative [name] (module-name-to-index-relative-loop name 0 (string-length name) ""))
(defn is-trailing-path-whitespace [text idx] (let [ch (path-char text idx)] (if (= ch 10) true (if (= ch 13) true (if (= ch 32) true (if (= ch 9) true false))))))
(defn trim-trailing-path-whitespace-loop [text end] (if (<= end 0) "" (if (is-trailing-path-whitespace text (- end 1)) (trim-trailing-path-whitespace-loop text (- end 1)) (substring text 0 end))))
(defn trim-trailing-path-whitespace [text] (trim-trailing-path-whitespace-loop text (string-length text)))
(defn module-name-to-flat-relative [name] (string-concat name ".ls"))
