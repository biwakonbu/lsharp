{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lsharp.dev/schemas/intent-graph.schema.json",
  "title": "L# intent/evidence graph manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nodes", "evidence", "edges"],
  "properties": {
    "schema_version": {"const": 1},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "reviews": {"type": "array", "items": {"$ref": "#/$defs/review"}},
    "review_evidence_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_digest",
        "source_commit",
        "artifact_digest",
        "trust_store_digest",
        "lifecycle_digest",
        "now"
      ],
      "properties": {
        "subject_digest": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "minLength": 1},
        "artifact_digest": {"type": "string", "minLength": 1},
        "trust_store_digest": {"type": ["string", "null"], "minLength": 1},
        "lifecycle_digest": {"type": ["string", "null"], "minLength": 1},
        "now": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "edges": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["relation", "intent", "claim"],
            "properties": {
              "relation": {"const": "motivates"},
              "intent": {"$ref": "#/$defs/id"},
              "claim": {"$ref": "#/$defs/id"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["relation", "claim", "assumption"],
            "properties": {
              "relation": {"const": "constrained-by"},
              "claim": {"$ref": "#/$defs/id"},
              "assumption": {"$ref": "#/$defs/id"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["relation", "claim", "contract"],
            "properties": {
              "relation": {"const": "tested-by"},
              "claim": {"$ref": "#/$defs/id"},
              "contract": {"$ref": "#/$defs/id"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["relation", "observation", "claim"],
            "properties": {
              "relation": {"enum": ["supports", "contradicts"]},
              "observation": {"$ref": "#/$defs/id"},
              "claim": {"$ref": "#/$defs/id"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["relation", "review", "subject"],
            "properties": {
              "relation": {"const": "evaluates"},
              "review": {"$ref": "#/$defs/id"},
              "subject": {"$ref": "#/$defs/review-subject"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["relation", "change", "subject"],
            "properties": {
              "relation": {"const": "invalidates"},
              "change": {"$ref": "#/$defs/id"},
              "subject": {"$ref": "#/$defs/invalidation-subject"}
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "key"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "key": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "namespace", "key"],
      "properties": {
        "kind": {"enum": ["intent", "claim", "contract", "evidence", "review"]},
        "namespace": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "key": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
      }
    },
    "review-subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "namespace", "key"],
      "properties": {
        "kind": {"enum": ["intent", "claim", "evidence"]},
        "namespace": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "key": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
      }
    },
    "invalidation-subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "namespace", "key"],
      "properties": {
        "kind": {"enum": ["evidence", "review"]},
        "namespace": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "key": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
      }
    },
    "evidence-subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "namespace", "key"],
      "properties": {
        "kind": {"enum": ["intent", "claim", "contract"]},
        "namespace": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "key": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "namespace", "key", "text"],
      "properties": {
        "kind": {"enum": ["intent", "claim", "assumption", "open-question"]},
        "namespace": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "key": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "text": {"type": "string", "minLength": 1},
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "end": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "key", "provenance_digest", "visibility"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "key": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "provenance_digest": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["public", "redacted"]},
        "verification_state": {"enum": ["verified", "unverified", "stale", "revoked"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "key", "method", "subject", "outcome", "execution", "provenance", "independence"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "key": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "method": {"enum": ["example", "case", "assert", "property", "production", "reference", "proof", "review"]},
        "subject": {"$ref": "#/$defs/evidence-subject"},
        "outcome": {"enum": ["pass", "fail", "contradicted", "unknown", "stale"]},
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runner", "target", "source_commit", "artifact_digest", "sampling"],
          "properties": {
            "runner": {"type": "string", "minLength": 1},
            "target": {"type": "string", "minLength": 1},
            "source_commit": {"type": "string", "minLength": 1},
            "artifact_digest": {"type": "string", "minLength": 1},
            "sampling": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cases", "seed", "generator"],
              "properties": {
                "cases": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
                "seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
                "generator": {"type": "string", "minLength": 1},
                "shrinks": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}},
                "coverage": {
                  "type": "object",
                  "propertyNames": {"type": "string", "pattern": "\\S"},
                  "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
                }
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["producer", "tool_version", "timestamp"],
          "properties": {
            "producer": {"type": "string", "minLength": 1},
            "tool_version": {"type": "string", "minLength": 1},
            "timestamp": {"type": "string", "minLength": 1}
          }
        },
        "independence": {"enum": ["same-author", "independent-review", "external-observation"]}
      }
    }
  }
}
