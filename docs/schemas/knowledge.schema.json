{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L# Knowledge Base Entry",
  "type": "object",
  "required": ["module", "functions", "types"],
  "properties": {
    "module": { "type": "string" },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "arity", "params", "returns"],
        "properties": {
          "name": { "type": "string" },
          "arity": { "type": "integer" },
          "doc": { "type": "string" },
          "example": { "type": "string" },
          "params": { "type": "array", "items": { "type": "string" } },
          "returns": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["type", "recorddef", "typealias", "typeconstrained"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
