{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L# Code Review Output",
  "type": "object",
  "required": ["source", "diagnostics"],
  "properties": {
    "source": { "type": "string" },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "message", "line"],
        "properties": {
          "severity": { "type": "string", "enum": ["error", "warning", "info", "hint"] },
          "message": { "type": "string" },
          "line": { "type": "integer" },
          "column": { "type": "integer" },
          "code": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
