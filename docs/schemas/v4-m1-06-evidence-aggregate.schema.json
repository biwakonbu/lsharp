{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/biwakonbu/lsharp/blob/main/docs/schemas/v4-m1-06-evidence-aggregate.schema.json",
  "title": "L# v0.4 M1-06 two-target evidence aggregate",
  "description": "Machine-readable declaration for the two supported target evidence indexes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite", "task", "source_commit", "status", "indexes"],
  "properties": {
    "schema_version": {"const": 1},
    "suite": {"const": "v4-m1-06-aggregate"},
    "task": {"const": "V4-M1-01"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["pass", "pending", "mismatch"]},
    "indexes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "index"],
          "properties": {
            "target": {"const": "aarch64-apple-darwin"},
            "index": {
              "type": "string",
              "minLength": 1,
              "pattern": "^ci-artifacts/v4-m1-01/[0-9a-f]{40}/aarch64-apple-darwin/index\\.json$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "index"],
          "properties": {
            "target": {"const": "x86_64-unknown-linux-gnu"},
            "index": {
              "type": "string",
              "minLength": 1,
              "pattern": "^ci-artifacts/v4-m1-01/[0-9a-f]{40}/x86_64-unknown-linux-gnu/index\\.json$"
            }
          }
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "index"],
        "properties": {
          "target": {
            "enum": ["aarch64-apple-darwin", "x86_64-unknown-linux-gnu"]
          },
          "index": {
            "type": "string",
            "minLength": 1,
            "pattern": "^ci-artifacts/v4-m1-01/[0-9a-f]{40}/(?:aarch64-apple-darwin|x86_64-unknown-linux-gnu)/index\\.json$"
          }
        }
      }
    }
  }
}
