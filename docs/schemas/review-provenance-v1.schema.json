{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lsharp.dev/schemas/review-provenance-v1.schema.json",
  "title": "L# review provenance wire v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attestations", "lifecycle"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "attestations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attestation"
      }
    },
    "lifecycle": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lifecycle"
      }
    },
    "trust_store": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trust_key"
      }
    }
  },
  "$defs": {
    "stable_review_id": {
      "type": "string",
      "pattern": "^review:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\s]"
    },
    "canonical_utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "canonical_base64url": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-]{4})+$"
        },
        {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-]{4})*[A-Za-z0-9_-][AQgw]$"
        },
        {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-]{4})*[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048]$"
        }
      ]
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "subject_digest",
        "source_commit",
        "provenance_digest",
        "provider",
        "key_id",
        "algorithm",
        "signature",
        "issued_at",
        "sequence"
      ],
      "properties": {
        "review_id": {
          "$ref": "#/$defs/stable_review_id"
        },
        "subject_digest": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_commit": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provenance_digest": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provider": {
          "$ref": "#/$defs/non_empty_string"
        },
        "key_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "algorithm": {
          "const": "ed25519"
        },
        "signature": {
          "$ref": "#/$defs/canonical_base64url"
        },
        "issued_at": {
          "$ref": "#/$defs/canonical_utc_timestamp"
        },
        "expires_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/canonical_utc_timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "sequence", "state", "effective_at"],
      "properties": {
        "review_id": {
          "$ref": "#/$defs/stable_review_id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "state": {
          "enum": ["proposed", "active", "superseded", "revoked"]
        },
        "effective_at": {
          "$ref": "#/$defs/canonical_utc_timestamp"
        },
        "reason_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "trust_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "key_id", "algorithm", "public_key"],
      "properties": {
        "provider": {
          "$ref": "#/$defs/non_empty_string"
        },
        "key_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "algorithm": {
          "const": "ed25519"
        },
        "public_key": {
          "allOf": [
            {
              "$ref": "#/$defs/canonical_base64url"
            }
          ],
          "minLength": 43,
          "maxLength": 43
        }
      }
    }
  }
}
