{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L# Documentation Output",
  "type": "object",
  "required": ["module", "functions", "types", "html"],
  "properties": {
    "module": { "type": "string" },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "arity", "params", "returns"],
        "properties": {
          "name": { "type": "string" },
          "arity": { "type": "integer" },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "doc": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "returns": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string" },
              "doc": { "type": "string" }
            },
            "additionalProperties": false
          },
          "doc": { "type": "string" },
          "example": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "html": {
      "type": "object",
      "required": ["title", "sections"],
      "properties": {
        "title": { "type": "string" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "count"],
            "properties": {
              "id": { "type": "string", "enum": ["functions", "types"] },
              "count": { "type": "integer" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
