{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L# Documentation Output",
  "type": "object",
  "required": ["module", "public_functions", "types", "html"],
  "properties": {
    "module": { "type": "string" },
    "public_functions": { "type": "integer" },
    "types": { "type": "integer" },
    "html": {
      "type": "object",
      "required": ["title", "sections"],
      "properties": {
        "title": { "type": "string" },
        "sections": { "type": "integer" }
      }
    }
  },
  "additionalProperties": false
}
